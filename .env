# # PostgreSQL 16 connection (running on localhost)
# DATABASE_URL=postgresql+psycopg://asset_user:asset_pass@localhost:5434/fixed_asset_manager

# # JWT
# JWT_SECRET=change-this-to-a-long-random-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=120

# # CORS - comma separated list of allowed origins (Flutter web dev server, etc.)
# CORS_ORIGINS=http://localhost:8000,http://localhost:61583,http://127.0.0.1:8080


# # Copy this file to .env and fill in your values

# PostgreSQL connection string — using your default postgres user
# ⚠️ change the port below to match yours (yours is 5434, not the default 5432)
DATABASE_URL=postgresql://postgres:passbarcodb990@localhost:5434/fixed_asset_manager

# JWT secret — use a long random string in production
SECRET_KEY=change-me-in-production

# Token expiry in minutes (default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed origins (Flutter web dev server, etc.)
# CORS_ORIGINS=http://localhost:8080,http://localhost:5000,http://127.0.0.1:8080
CORS_ORIGINS=*
